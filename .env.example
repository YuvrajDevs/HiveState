# Supabase (free tier is enough). Server-side only: never expose the service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Model providers: set at least one, or add keys in Settings (environment variables win).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# USD_INR_RATE=88               # currency conversion for cost tracking
# HIVESTATE_MOCK_LLM=1          # route every model to an offline mock (no keys, no cost)
# HIVESTATE_INLINE_DRAIN=0      # set when a dedicated worker (npm run worker) executes runs
# CRON_SECRET=                  # enables GET /api/jobs/drain for a scheduler (Authorization: Bearer <secret>)
# DEMO_MODE=1                   # public demo: "Clear finished" keeps the seeded demo runs
# DATABASE_URL=                 # Postgres connection string, for npm run seed:demo and db:replay
